# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5174

# MongoDB
MONGO_URI=mongodb://localhost:27017/mpesa_db

# Safaricom Daraja (M-Pesa)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_stk_push_passkey
MPESA_SHORTCODE=174379
TILL_NO=174379
MPESA_TRANSACTIONTYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-public-domain.ngrok-free.app/api/stkpush/callback
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# See README.md "Stripe Integration" section for how to wire up
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET if you add card payments.
